NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://shieldgate:shieldgate@localhost:5432/shieldgate
MONGODB_URL=mongodb://shieldgate:shieldgate@localhost:27017/?authSource=shieldgate
MONGODB_DATABASE=shieldgate
REDIS_URL=redis://localhost:6379

CONSOLE_ORIGINS=http://localhost:5173
# Local development runs over plain HTTP.
COOKIE_SECURE=false

# Generate each secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEYS=1:REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
TOTP_ENCRYPTION_KEY_ID=1
API_KEY_PEPPER=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64

# Used by `pnpm db:seed` to create the first administrator.
SEED_ADMIN_EMAIL=admin@shieldgate.local
SEED_ADMIN_PASSWORD=change-me-to-a-long-passphrase
