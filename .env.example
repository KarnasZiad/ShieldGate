# Secrets of the Docker Compose stack (docker compose --profile app up). Copy to .env, never commit it.
# Generate each value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEYS=1:REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
API_KEY_PEPPER=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
